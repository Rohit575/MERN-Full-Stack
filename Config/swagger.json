{
  "openapi": "3.0.0",
  "info": {
    "title": "Muknayak API Documentation",
    "description": "API documentation for Muknayak Graphics",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3580",
      "description": "Local server"
    },
    {
      "url": "https://muknayak.vercel.app/",
      "description": "Production server"
    }
  ],
  "tags": [],
  "paths": {},
  "components": {
    "securitySchemes": {
      "JWTAuth": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "description": "JWT Authorization header using the Bearer scheme. Example: \"Authorization: Bearer <token>\""
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "integer" },
          "address": { "type": "string" },
          "state": { "type": "string" },
          "country": { "type": "string" },
          "pinCode": { "type": "integer" },
          "isAdmin": {
            "type": "string",
            "enum": ["admin", "user"],
            "default": "user"
          },
          "profileImage": {
            "type": "object",
            "properties": {
              "imageUrl": { "type": "string" },
              "imgPublicId": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
